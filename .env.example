# ── Client (inlined at build time; NEXT_PUBLIC_ prefix required) ──
NEXT_PUBLIC_DJANGO_API_URL=
NEXT_PUBLIC_DISCORD_AUTH_URL=

# ── Server (runtime; in deploys these come from Netlify site env, not CI) ──
BACKEND_URL=

# ---------------------------------------------------------------------------
# "Sign in with muLearn" (OIDC)
#
# Where the identity provider lives. Every sign-in redirects here.
# Example: https://auth.mulearn.org
NEXT_PUBLIC_OIDC_ISSUER=

# This app's registered client id. Created with authserver's
# `register_oauth_client` command, ONE PER ENVIRONMENT - never share a client
# between dev and production, because they have different redirect URLs and a
# leaked dev client would otherwise be usable against production.
#
# The dashboard is a PUBLIC client: it holds no secret and relies on PKCE.
# There is deliberately no NEXT_PUBLIC_OIDC_CLIENT_SECRET; anything prefixed
# NEXT_PUBLIC_ is shipped to the browser, so a secret here would not be one.
NEXT_PUBLIC_OIDC_CLIENT_ID=

# Switch the dashboard over to "Sign in with muLearn". Server-side only, so it
# is not shipped to the browser.
#
#   unset / "false"  -> the existing login form (current behaviour)
#   "true"           -> /login hands off to the identity provider
#
# Flipping this does NOT log anyone out: it only changes where a NEW sign-in
# happens. Existing sessions keep working, so people migrate by attrition.
# Turn it on in dev first; turning it back off needs no deploy.
OIDC_ENABLED=false

# Fixed callback URL, registered on authserver's client per environment.
# Server-only, and deliberately NOT derived from the request: on Netlify the
# request origin inside a route handler is the deploy permalink
# (<deploy-id>--<site>.netlify.app), not this app's real domain, and
# authserver matches redirect_uri exactly — a derived value gets sign-in
# refused in prod while working fine on localhost, which is what makes it
# easy to miss.
# Example: https://app.mulearn.org/api/auth/oidc/callback
OIDC_REDIRECT_URI=

# Required together with the three vars above once OIDC_ENABLED=true —
# config/env.ts fails the build if any is missing while the flag is on.
